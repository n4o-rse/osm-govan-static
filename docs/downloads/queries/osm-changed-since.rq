PREFIX ogsp: <https://n4o-rse.github.io/osm-govan-static/prop/>
PREFIX ogspq: <https://n4o-rse.github.io/osm-govan-static/prop/qualifier/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX wikibase: <http://wikiba.se/ontology#>

SELECT ?item ?label ?number ?timestamp ?user WHERE {
  ?item ogsp:P101 ?version ;
        rdfs:label ?label .
  ?version wikibase:rank wikibase:PreferredRank ;
           ogspq:P102 ?number ;
           ogspq:P103 ?timestamp ;
           ogspq:P105 ?user .
  FILTER(LANG(?label) = "en")
  FILTER(?timestamp >= "2025-01-01T00:00:00Z")
}
ORDER BY DESC(?timestamp) ?label ?item
LIMIT 200
