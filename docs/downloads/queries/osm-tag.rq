PREFIX ogsp: <https://n4o-rse.github.io/osm-govan-static/prop/>
PREFIX ogsps: <https://n4o-rse.github.io/osm-govan-static/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?item ?label ?tag WHERE {
  ?item ogsp:P113 ?statement ;
        rdfs:label ?label .
  ?statement ogsps:P113 ?tag .
  FILTER(LANG(?label) = "en")
  FILTER(?tag = "historic=hogback")
}
ORDER BY ?label ?item
LIMIT 200
