PREFIX ogsp: <https://n4o-rse.github.io/osm-govan-static/prop/>
PREFIX ogspq: <https://n4o-rse.github.io/osm-govan-static/prop/qualifier/>
PREFIX ogsps: <https://n4o-rse.github.io/osm-govan-static/prop/statement/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

#defaultView:Map
SELECT ?item ?label ?geometry ?since WHERE {
  ?item ogsp:P111 ?entry ;
        rdfs:label ?label .
  ?entry ogsps:P111 ?geometry ;
         ogspq:P103 ?since .
  FILTER(LANG(?label) = "en")
  FILTER(?since <= "2023-01-01T00:00:00Z")
  FILTER NOT EXISTS {
    ?item ogsp:P111 ?later .
    ?later ogspq:P103 ?laterSince .
    FILTER(?laterSince > ?since && ?laterSince <= "2023-01-01T00:00:00Z")
  }
}
ORDER BY ?label ?item
LIMIT 200
